# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ต้องไม่ถูก commit เข้า git)

# API key สำหรับ Google Gemini (ใช้ผ่าน google-genai + instructor ใน agents/)
GOOGLE_API_KEY=your_google_api_key_here

# (ทางเลือก) path ของ skill taxonomy master ถ้าไม่ได้วางไว้ที่ default
# ค่า default อยู่ใน agents/skill_normalizer.py แล้ว ไม่ต้องตั้งถ้าใช้โครงสร้าง repo ตามที่แนะนำ
SKILL_TAXONOMY_PATH=data/skill_taxonomy_master.csv

# (ทางเลือก) ค่า threshold ความคล้ายสำหรับ skill normalization (0-1)
# ปรับได้ถ้าต้องการ tune accuracy vs unsupported-claims-rate ระหว่างพัฒนา
SKILL_SIMILARITY_THRESHOLD=0.55
