# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ต้องไม่ถูก commit เข้า git)

# ── REQUIRED ─────────────────────────────────────────────
# API key หลักสำหรับ Google Gemini (จำเป็นต้องมีอย่างน้อย 1 ตัว)
GOOGLE_API_KEY=your_google_api_key_here

# ── OPTIONAL: Key Rotation (สำหรับ rate-limit tolerance) ──
# ใส่เพิ่มได้ถ้ามี key หลายตัว — ระบบจะ rotate อัตโนมัติเมื่อ key ใดชนโควต้า 429
# ถ้าไม่มี ระบบจะใช้แค่ GOOGLE_API_KEY ตัวเดียวได้ปกติ (ไม่บังคับ)
# GOOGLE_API_KEY_FRIEND1=friend1_api_key_here
# GOOGLE_API_KEY_FRIEND2=friend2_api_key_here
# GOOGLE_API_KEY_FRIEND3=friend3_api_key_here
# GOOGLE_API_KEY_FRIEND4=friend4_api_key_here
# GOOGLE_API_KEY_FRIEND5=friend5_api_key_here

# ── OPTIONAL: Demo Fallback ───────────────────────────────
# ตั้งค่าเป็น true เพื่อสลับ pipeline เป็น mock mode (ไม่เรียก API)
# ใช้เป็น fallback ฉุกเฉินถ้า quota หมดระหว่าง demo
# สามารถสลับ runtime ได้ผ่าน POST /admin/toggle-mock?enable=true โดยไม่ต้อง restart
# USE_MOCK_PIPELINE=false

# Secret key ป้องกัน /admin/* endpoints จากการเรียกภายนอก
# จาก localhost ไม่ต้องมี secret / จาก IP อื่นต้องส่ง X-Admin-Secret header
# ถ้าไม่ตั้ง จะใช้ fallback 'demo-secret' (สำหรับ local dev เท่านั้น — ควรเปลี่ยนก่อน deploy)
# ADMIN_SECRET=change-me-before-deploy

# ── OPTIONAL: Skill Normalization ────────────────────────
# (ทางเลือก) path ของ skill taxonomy master ถ้าไม่ได้วางไว้ที่ default
SKILL_TAXONOMY_PATH=data/skill_taxonomy_master.csv

# (ทางเลือก) ค่า threshold ความคล้ายสำหรับ skill normalization (0-1)
SKILL_SIMILARITY_THRESHOLD=0.55